{
  "name": "forgepublicsafety-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cms:server": "decap-server",
    "functions:install": "npm install --prefix functions --omit=dev",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy:rules": "npx firebase-tools deploy --only storage,firestore:rules",
    "deploy:storage": "npx firebase-tools deploy --only storage",
    "deploy:full": "npm run build && npx firebase-tools deploy --only hosting,firestore,storage",
    "deploy:functions": "npm run functions:install && npx firebase-tools deploy --only functions",
    "deploy:all": "npm run build && npm run functions:install && npx firebase-tools deploy",
    "staff:scrape": "node forge-academy/scripts/scrape-afta-staff.mjs",
    "staff:import": "node forge-academy/scripts/import-afta-staff.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.11",
    "firebase": "^12.16.0",
    "lucide-react": "^0.525.0",
    "nanoid": "^5.1.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.7.0",
    "decap-cms": "^3.8.0",
    "decap-server": "^3.3.0",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4"
  }
}
