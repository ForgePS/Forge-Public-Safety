# Storage mode: "local" (browser localStorage demo) or "firebase" (Firestore)
VITE_FLEET_STORAGE=local

# Firebase web app config (required when VITE_FLEET_STORAGE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# RMS integration (future — used by webhook/export layer)
VITE_RMS_INTEGRATION_SECRET=
VITE_RMS_API_BASE_URL=
