# Firebase web SDK — required for large image uploads (Storage)
#
# 1. Copy this file to `.env.local` (same folder as package.json)
# 2. Fill values from Firebase Console → Project settings → Your apps → Web app
# 3. Project should be: forge-website-b276c
# 4. Rebuild + redeploy hosting so Vite inlines these keys
# 5. Deploy storage rules: npm run deploy:rules
# 6. Enable Anonymous Authentication (needed for Storage writes from the CMS)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=forge-website-b276c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=forge-website-b276c
# Usually one of:
#   forge-website-b276c.appspot.com
#   forge-website-b276c.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Keep this FALSE unless you intentionally migrate CMS pages to Firestore.
# Storage uploads work with local CMS pages when this is false.
VITE_FIREBASE_USE_FIRESTORE=false
